{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dformer.local/schemas/museg-training-protocol-v1.json",
  "title": "MUSeg training protocol manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "schedule_version", "phase", "model",
    "config_module", "git", "seeds", "output_root", "splits", "pretrained",
    "training", "swanlab"
  ],
  "properties": {
    "schema_version": {"const": "museg-training-protocol-v1"},
    "protocol_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"},
    "schedule_version": {"type": "string", "minLength": 1},
    "phase": {"enum": ["qualification", "development", "official"]},
    "model": {"type": "string", "minLength": 1},
    "config_module": {"type": "string", "minLength": 1},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_commit"],
      "properties": {"required_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}}
    },
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "output_root": {"type": "string", "minLength": 1},
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_dev", "val_dev", "official_train", "official_test"],
      "properties": {
        "train_dev": {"$ref": "#/$defs/split"},
        "val_dev": {"$ref": "#/$defs/split"},
        "official_train": {"$ref": "#/$defs/split"},
        "official_test": {"allOf": [{"$ref": "#/$defs/split"}, {"required": ["sealed_unread"], "properties": {"sealed_unread": {"const": true}}}]}
      }
    },
    "pretrained": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "training": {
      "type": "object", "additionalProperties": true,
      "required": ["epochs", "batch_size", "val_batch_size", "workers", "eval_start_epoch", "eval_interval", "save_interval", "amp", "compile", "syncbn", "sliding", "mst"],
      "properties": {
        "epochs": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "val_batch_size": {"type": "integer", "minimum": 1},
        "workers": {"type": "integer", "minimum": 0},
        "eval_start_epoch": {"type": "integer", "minimum": 1},
        "eval_interval": {"type": "integer", "minimum": 1},
        "save_interval": {"type": "integer", "minimum": 1},
        "amp": {"type": "boolean"}, "compile": {"type": "boolean"},
        "syncbn": {"type": "boolean"}, "sliding": {"type": "boolean"}, "mst": {"type": "boolean"}
      }
    },
    "swanlab": {
      "type": "object", "additionalProperties": true,
      "required": ["mode", "project", "workspace"],
      "properties": {
        "mode": {"enum": ["disabled", "offline", "online"]},
        "project": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "run_name": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "split": {
      "type": "object", "additionalProperties": true,
      "required": ["path", "samples", "groups", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "samples": {"type": "integer", "minimum": 0},
        "groups": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "sealed_unread": {"type": "boolean"}
      }
    }
  }
}