{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dformer.local/schemas/museg-training-protocol-v3.json",
  "title": "MUSeg training protocol manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "schedule_version", "phase", "model", "config_module",
    "git", "seeds", "output_root", "split_authority", "official_train", "pretrained", "input_contract", "training", "swanlab"
  ],
  "properties": {
    "schema_version": {"const": "museg-training-protocol-v3"},
    "protocol_id": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"},
    "schedule_version": {"type": "string", "minLength": 1},
    "phase": {"enum": ["qualification", "development", "official"]},
    "model": {"type": "string", "minLength": 1},
    "config_module": {"type": "string", "minLength": 1},
    "run_kind": {"enum": ["qualification", "standard", "probe", "lifecycle-test"]},
    "simulation": {"type": "boolean"},
    "checkpoint_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["selector_geometry", "selector_scale", "selector_flip", "top_k", "retain_latest", "tie_break", "candidate_manifest"],
      "properties": {
        "selector_geometry": {"const": "original-full"}, "selector_scale": {"const": 1.0},
        "selector_flip": {"const": false}, "top_k": {"type": "integer", "minimum": 1, "maximum": 8}, "retain_latest": {"const": true},
        "tie_break": {"const": "earlier_epoch"}, "candidate_manifest": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$"}
      }
    },
    "optimizer_telemetry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "required_counters", "invariant"],
      "properties": {
        "schema_version": {"const": "museg-optimizer-telemetry-v1"},
        "required_counters": {"const": ["attempted_steps", "completed_optimizer_steps", "skipped_optimizer_steps"]},
        "invariant": {"const": "attempted_steps=completed_optimizer_steps+skipped_optimizer_steps"}
      }
    },
    "git": {
      "type": "object", "additionalProperties": false, "required": ["required_commit"],
      "properties": {"required_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}}
    },
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "output_root": {"type": "string", "minLength": 1},
    "split_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "audit_report_path", "audit_report_sha256"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "audit_report_path": {"type": "string", "minLength": 1},
        "audit_report_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "official_train": {
      "type": "object", "additionalProperties": false, "required": ["path"],
      "properties": {"path": {"type": "string", "minLength": 1}}
    },
    "pretrained": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_order", "normalization"],
      "properties": {
        "channel_order": {"enum": ["BGR", "RGB"]},
        "normalization": {
          "type": "object", "additionalProperties": false,
          "required": ["identity", "mean", "std"],
          "properties": {
            "identity": {"type": "string", "minLength": 1},
            "mean": {"$ref": "#/$defs/channel_triplet"},
            "std": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["epochs", "batch_size", "val_batch_size", "workers", "eval_start_epoch", "eval_interval", "save_interval", "amp", "compile", "syncbn", "sliding", "mst"],
      "properties": {
        "epochs": {"type": "integer", "minimum": 1}, "batch_size": {"type": "integer", "minimum": 1},
        "val_batch_size": {"type": "integer", "minimum": 1}, "workers": {"type": "integer", "minimum": 0},
        "eval_start_epoch": {"type": "integer", "minimum": 1}, "eval_interval": {"type": "integer", "minimum": 1},
        "save_interval": {"type": "integer", "minimum": 1}, "amp": {"type": "boolean"},
        "compile": {"type": "boolean"}, "syncbn": {"type": "boolean"}, "sliding": {"type": "boolean"}, "mst": {"type": "boolean"}
      }
    },
    "swanlab": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "project", "workspace"],
      "properties": {
        "mode": {"enum": ["disabled", "offline", "online"]}, "project": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1}, "run_name": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "channel_triplet": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}